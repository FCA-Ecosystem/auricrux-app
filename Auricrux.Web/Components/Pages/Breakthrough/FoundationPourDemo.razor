@page "/breakthrough/foundation-pour"
@using Auricrux.Web.Services.Breakthrough
@inject FoundationPourDemoService DemoService
@inject ILogger<FoundationPourDemo> Logger
@rendermode InteractiveServer

<PageTitle>Foundation Pour Self-Correction — Auricrux</PageTitle>

<div class="pour-demo">
    <header class="pour-demo__hero">
        <p class="pour-demo__brand">Auricrux</p>
        <h1>Foundation pour self-correction</h1>
        <p class="pour-demo__lede">
            Competing pour hypotheses (ACI 209R / 306R / 305R) → field verification → meta-learning → provable reasoning.
            Operator inputs change the physics. Works without Atlas (in-process loop store).
        </p>
        <div class="pour-demo__actions">
            <label>Target psi <input type="number" @bind="targetPsi" min="2500" max="8000" step="100" /></label>
            <label>Ambient °F <input type="number" @bind="ambientTempF" min="0" max="120" step="1" /></label>
            <label>Thickness in <input type="number" @bind="slabThicknessIn" min="4" max="48" step="0.5" /></label>
            <label>RH (0–1) <input type="number" @bind="relativeHumidity" min="0.05" max="1" step="0.05" /></label>
            <label>Wind mph <input type="number" @bind="windSpeedMph" min="0" max="40" step="1" /></label>
            <button class="pour-demo__run" disabled="@running" @onclick="RunDemoAsync">
                @(running ? "Running loop…" : "Run self-correction loop")
            </button>
        </div>
    </header>

    @if (error is not null)
    {
        <div class="pour-demo__error" role="alert">
            <strong>Demo failed.</strong> @error
        </div>
    }
    else if (result is null && !running)
    {
        <p class="pour-demo__empty">No run yet. Start the loop to generate hypotheses and verify them.</p>
    }
    else if (running)
    {
        <p class="pour-demo__loading">Generating hypotheses and verifying field divergence…</p>
    }
    else if (result is not null)
    {
        <section class="pour-demo__summary" aria-live="polite">
            <h2>Loop @(result.LoopClosed ? "closed" : "open")</h2>
            <p>@result.Summary</p>
            <dl class="pour-demo__meta">
                <div><dt>Scenario</dt><dd>@result.ScenarioName</dd></div>
                <div><dt>Decision</dt><dd><code>@result.DecisionId</code></dd></div>
                <div><dt>Recommended</dt><dd>@result.RecommendedApproach</dd></div>
                <div><dt>Verification accuracy</dt><dd>@result.Verification.AccuracyScore.ToString("P0")</dd></div>
                <div><dt>Correction required</dt><dd>@(result.Verification.RequiresModelCorrection ? "Yes" : "No")</dd></div>
                <div><dt>Meta-learning samples</dt><dd>@result.MetaLearning.TotalPredictions</dd></div>
                <div><dt>Proof certainty</dt><dd>@result.Proof.CertaintyLevel.ToString("P0")</dd></div>
                @if (result.Incomplete)
                {
                    <div><dt>Prior</dt><dd>Incomplete — silenced</dd></div>
                }
            </dl>
        </section>

        <section class="pour-demo__step">
            <h2>5. Pedagogy as actuator</h2>
            <p>
                Phase II proposes a governed hold/proceed from a closed loop.
                Catalog matching is not unique lesson synthesis. Human accept is required before any schedule mutation.
            </p>
            @if (result.PedagogySilence)
            {
                <p class="pour-demo__reason">Pedagogy silenced. @(result.IncompleteReason ?? "Incomplete prior or open loop.")</p>
            }
            else
            {
                <dl class="pour-demo__meta">
                    <div><dt>Proposed act</dt><dd><code>@result.PedagogyProposedAction</code></dd></div>
                    <div><dt>Lesson</dt><dd>@result.PedagogyLessonTopic</dd></div>
                    @if (result.PedagogyPriorLessonConfirmed)
                    {
                        <div><dt>Improve</dt><dd>Prior job lesson confirmed the same act. Still not unique synthesis.</dd></div>
                    }
                    @if (result.PedagogyHoldStillInForce)
                    {
                        <div><dt>Improve</dt><dd>Hold still in force. Confirming the same Auricrux control. Still not unique synthesis.</dd></div>
                    }
                    @if (result.PourControl is not null)
                    {
                        <div><dt>Pour control</dt>
                            <dd>
                                Strip day @result.PourControl.CurrentStripDays (baseline @result.PourControl.BaselineStripDays).
                                @(result.PourControl.HoldActive ? "Hold active." : "Not held.")
                                Not a PM schedule row.
                            </dd>
                        </div>
                    }
                    @if (result.ErectionControl is not null)
                    {
                        <div><dt>Erection control</dt>
                            <dd>
                                Erection day @result.ErectionControl.CurrentErectionDays (baseline @result.ErectionControl.BaselineErectionDays).
                                @(result.ErectionControl.HoldActive ? "Hold active." : "Not held.")
                                Not a PM schedule row.
                            </dd>
                        </div>
                    }
                </dl>
                <p class="pour-demo__reason">@result.PedagogyLesson</p>
                @if (result.PedagogyRecorded)
                {
                    <p class="pour-demo__preds">Recorded in process memory as <code>@result.PedagogyLessonId</code>. Not Atlas. Not catalog matching.</p>
                }
            }
            @if (result.PriorJobLessons.Count > 0)
            {
                <h3 class="pour-demo__subhead">Prior job-derived lessons (this process)</h3>
                <ul>
                    @foreach (var lesson in result.PriorJobLessons.Take(5))
                    {
                        <li><code>@lesson.ProposedAction</code> — @lesson.Topic</li>
                    }
                </ul>
            }
        </section>

        <section class="pour-demo__step">
            <h2>1. Competing hypotheses</h2>
            <p class="pour-demo__reason">@result.RecommendationReasoning</p>
            <ul class="pour-demo__hypotheses">
                @foreach (var h in result.Hypotheses)
                {
                    var selected = h.HypothesisId == result.ChosenHypothesisId;
                    <li class="@(selected ? "is-chosen" : null)">
                        <strong>@h.Approach</strong>
                        <span>confidence @h.ConfidenceScore.ToString("P0")@(selected ? " — chosen for verification" : "")</span>
                        <p>@h.PredictedOutcome</p>
                        @if (h.QuantitativePredictions.Count > 0)
                        {
                            <p class="pour-demo__preds">
                                Predictions:
                                @string.Join(", ", h.QuantitativePredictions.Select(kv => $"{kv.Key}={kv.Value}"))
                            </p>
                        }
                        @if (h.RiskFactors.Count > 0)
                        {
                            <ul class="pour-demo__risks">
                                @foreach (var risk in h.RiskFactors.Take(4))
                                {
                                    <li>@risk</li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        </section>

        <section class="pour-demo__step">
            <h2>2. Physical verification</h2>
            <p>
                Accuracy @result.Verification.AccuracyScore.ToString("P1") ·
                Correction required: <strong>@(result.Verification.RequiresModelCorrection ? "yes" : "no")</strong>
            </p>
            <p class="pour-demo__reason">@result.Verification.CorrectionRationale</p>
            @if (result.Verification.IdentifiedErrors.Count > 0)
            {
                <ul>
                    @foreach (var errItem in result.Verification.IdentifiedErrors)
                    {
                        <li>@errItem</li>
                    }
                </ul>
            }
            @if (result.Verification.MeasurementVariances.Count > 0)
            {
                <table class="pour-demo__table">
                    <thead>
                        <tr>
                            <th>Measurement</th>
                            <th>Predicted</th>
                            <th>Actual</th>
                            <th>Variance</th>
                            <th>In tol.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in result.Verification.MeasurementVariances.Values)
                        {
                            <tr>
                                <td>@v.Measurement</td>
                                <td>@(v.Predicted?.ToString("0.##") ?? "—")</td>
                                <td>@(v.Actual?.ToString("0.##") ?? "—")</td>
                                <td>@(v.VariancePercent is null ? "—" : $"{v.VariancePercent:0.#}%")</td>
                                <td>@(v.WithinTolerance ? "yes" : "no")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="pour-demo__step">
            <h2>3. Meta-learning</h2>
            <p>
                @result.MetaLearning.TotalPredictions predictions ·
                overall accuracy @result.MetaLearning.OverallAccuracy.ToString("P1")
            </p>
            @if (result.MetaLearning.SystematicErrors.Count > 0)
            {
                <ul class="pour-demo__hypotheses">
                    @foreach (var e in result.MetaLearning.SystematicErrors)
                    {
                        <li>
                            <strong>@e.ErrorPattern</strong>
                            <span>@e.AffectedDomain · @e.Occurrences× · avg variance @e.AverageVariance.ToString("0.#")%</span>
                            <p>@e.ProposedCorrection</p>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="pour-demo__empty">No systematic error patterns above threshold yet.</p>
            }
            @if (result.MetaLearning.RecommendedExperiments.Count > 0)
            {
                <h3 class="pour-demo__subhead">Recommended experiments</h3>
                <ol>
                    @foreach (var exp in result.MetaLearning.RecommendedExperiments)
                    {
                        <li>@exp</li>
                    }
                </ol>
            }
        </section>

        <section class="pour-demo__step">
            <h2>4. Provable reasoning</h2>
            <p class="pour-demo__reason">@result.Proof.Conclusion</p>
            <p>Certainty @result.Proof.CertaintyLevel.ToString("P0")</p>
            @if (result.Proof.ProofSteps.Count > 0)
            {
                <ol>
                    @foreach (var step in result.Proof.ProofSteps)
                    {
                        <li>@step</li>
                    }
                </ol>
            }
            @if (result.Proof.CitedStandards.Count > 0)
            {
                <p class="pour-demo__preds">Standards: @string.Join(", ", result.Proof.CitedStandards)</p>
            }
            @if (!string.IsNullOrWhiteSpace(result.Proof.LimitationsDisclosure))
            {
                <p class="pour-demo__limit">@result.Proof.LimitationsDisclosure</p>
            }
        </section>
    }
</div>

@code {
    private FoundationPourDemoResult? result;
    private string? error;
    private bool running;
    private double targetPsi = 4000;
    private double ambientTempF = 42;
    private double slabThicknessIn = 8;
    private double relativeHumidity = 0.55;
    private double windSpeedMph = 8;

    private async Task RunDemoAsync()
    {
        running = true;
        error = null;
        result = null;
        try
        {
            result = await DemoService.RunAsync(new FoundationPourDemoOptions
            {
                ProjectId = $"web-pour-{Guid.NewGuid():N}",
                TargetPsi = targetPsi,
                AmbientTempF = ambientTempF,
                SlabThicknessIn = slabThicknessIn,
                RelativeHumidity = relativeHumidity,
                WindSpeedMph = windSpeedMph,
                DecisionContext =
                    $"Foundation pour for {slabThicknessIn:0.#}-inch slab, {targetPsi:0} PSI, ambient {ambientTempF:0.#}°F, RH {relativeHumidity:P0}, wind {windSpeedMph:0.#} mph."
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Foundation pour demo failed");
            error = ex.Message;
        }
        finally
        {
            running = false;
        }
    }
}
